# ==============================================================================
# Yewbdar Junk Removal - Environment Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Lead Notification Engine (Resend)
# ------------------------------------------------------------------------------
# API Key from https://resend.com
# If omitted during local development, lead submissions are safely logged to the console
# and the UI displays the confirmation checkmark without throwing errors.
RESEND_API_KEY=re_your_api_key_here

# The client/dispatch inbox that receives incoming customer booking requests
# Note: On free/trial Resend accounts without a verified domain, this MUST be the email you used to register on Resend.
LEAD_NOTIFICATION_EMAIL=dispatch@yewbdarjunk.com

# Optional sender address. Defaults to "Yewbdar Junk Removal <onboarding@resend.dev>" for instant testing.
# Once your custom domain is verified in Resend, change this to: "Yewbdar Dispatch <dispatch@yourdomain.com>"
RESEND_FROM_EMAIL=Yewbdar Junk Removal <onboarding@resend.dev>

# ------------------------------------------------------------------------------
# 2. Sanity Studio CMS
# ------------------------------------------------------------------------------
# Project ID and dataset from https://sanity.io/manage
# If omitted, the web application seamlessly serves the verified local fallback dataset.
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
